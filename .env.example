# Brand — change these and redeploy
NEXT_PUBLIC_STORE_NAME=Lumen
NEXT_PUBLIC_STORE_TAGLINE=Simple digital products. Run by AI agents.
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com
NEXT_PUBLIC_OWNER_NAME=Store Owner

# Security — generate any long random string
STORE_SECRET=change-me-to-a-long-random-string

# Stripe — leave blank to use demo checkout (no real charges)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Stripe Price IDs if you create products in the Stripe dashboard
# If empty, checkout creates one-off prices from catalog data
STRIPE_PRICE_STARTER=
STRIPE_PRICE_KIT=
STRIPE_PRICE_MEMBER=
